# HEALTH PLUS — Environment Variables Template
# Copy this file to frontend/.env and backend/.env as appropriate. Never commit actual secret keys.

# ==============================================================================
# FRONTEND CONFIGURATION (Vite / React)
# ==============================================================================
VITE_APP_NAME="HEALTH PLUS"
VITE_APP_TAGLINE="Observe. Understand. Guide."
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Supabase Client Configuration (Public Anon Key only, no service role on client!)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Feature Flags
VITE_ENABLE_MOCK_EXERCISE="false"
VITE_ENABLE_SPEECH_COACH="true"

# ==============================================================================
# BACKEND CONFIGURATION (FastAPI / Python)
# ==============================================================================
ENV="development"
PORT=8000
HOST="0.0.0.0"

# Supabase Service Role & Database
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-backend-service-role-key"
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# LLM Provider Gateway (OpenAI / Anthropic / Gemini via Server Gateway)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"

# Food Vision Model / API Endpoint
FOOD_VISION_API_KEY="your-vision-api-key"

